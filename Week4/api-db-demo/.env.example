# Copy this file to .env and fill in the three Firebase values below.
PORT=3001

# Use project_id, client_email, and private_key from your service-account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# Keep the private key in double quotes, including its BEGIN/END lines and \n escapes.
# Example shape: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
